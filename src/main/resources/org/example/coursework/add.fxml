<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-padding: 24;" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.coursework.Controllers.AddController">

    <Label text="Add New Part" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="12.0" vgap="12.0">
        <Label text="Part ID (e.g. P001):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Part Name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Brand:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="brandField" promptText="e.g. Bajaj" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Price (Rs.):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" promptText="e.g. 3500.00" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Quantity:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="quantityField" promptText="e.g. 10" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Category:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="categoryField" promptText="e.g. ENGINE, ELECTRICAL, BODYWORK, BRAKES"
                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Purchase Date (yyyy-MM-dd):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="dateField" promptText="e.g. 2026-07-20" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Low Stock Threshold:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="thresholdField" promptText="e.g. 5 (default 10)" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Image:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <HBox spacing="8.0" GridPane.rowIndex="8" GridPane.columnIndex="1">
            <Button text="Choose Image..." onAction="#onChooseImage"/>
            <Label fx:id="imageFileLabel" text="No image selected"/>
        </HBox>
    </GridPane>

    <HBox spacing="16.0" alignment="CENTER">
        <Button text="Back" onAction="#onBack"/>
        <Button text="Add Part" onAction="#onAddPart"/>
    </HBox>
</VBox>
