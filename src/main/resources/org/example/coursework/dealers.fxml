<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.coursework.Controllers.DealerController">

    <Label text="Dealers (4 random, unique, sorted by location)" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="dealersTable" prefHeight="300.0">
        <columns>
            <TableColumn fx:id="idColumn" text="Dealer ID" prefWidth="90.0"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="160.0"/>
            <TableColumn fx:id="contactColumn" text="Contact Number" prefWidth="140.0"/>
            <TableColumn fx:id="locationColumn" text="Location" prefWidth="140.0"/>
        </columns>
    </TableView>

    <HBox spacing="12.0" alignment="CENTER">
        <Button text="Pick 4 Random Dealers" onAction="#onPickDealers"/>
        <Button text="Back" onAction="#onBack"/>
    </HBox>
</VBox>
