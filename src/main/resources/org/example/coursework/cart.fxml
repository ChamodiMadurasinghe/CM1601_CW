<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.coursework.Controllers.CartController">

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Point of Sale" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Part ID:" />
        <TextField fx:id="partIdField" prefWidth="90.0" />
        <Label text="Quantity:" />
        <TextField fx:id="quantityField" prefWidth="70.0" />
        <Button onAction="#onAddToCart" text="Add to Cart" />
    </HBox>

    <TableView fx:id="cartTable" prefHeight="260.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="80.0" text="Item Code" />
            <TableColumn fx:id="nameColumn" prefWidth="140.0" text="Item Name" />
            <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="Quantity" />
            <TableColumn fx:id="subtotalColumn" prefWidth="120.0" text="Subtotal (Rs.)" />
        </columns>
    </TableView>

    <Label fx:id="summaryLabel" style="-fx-font-weight: bold;" wrapText="true" />

    <HBox alignment="CENTER" spacing="12.0">
        <Button onAction="#onBack" text="Back" />
        <Button onAction="#onClearCart" text="Clear Cart" />
        <Button onAction="#onCheckout" text="Checkout" />
    </HBox>
</VBox>
