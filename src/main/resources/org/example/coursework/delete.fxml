<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="16.0" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.coursework.Controllers.DeleteController">

   <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Delete Part" />

   <HBox alignment="CENTER" spacing="8.0">
      <Label text="Enter Part ID :" />
      <TextField fx:id="idField" prefWidth="120.0" />
   </HBox>

   <Label fx:id="detailsLabel" wrapText="true" />

   <HBox alignment="CENTER" spacing="16.0">
      <Button onAction="#onFind" text="Find Part" />
      <Button onAction="#onDelete" style="-fx-text-fill: #b00020;" text="Delete Part" />
      <Button onAction="#onClose" text="Close" />
   </HBox>
</VBox>
